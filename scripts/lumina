#!/bin/bash
# ============================================================================
# Lumina Engine CLI Tool
# ============================================================================
# Usage:
#   lumina run [path]     - Run a Lumina project (looks for main.lua)
#   lumina example        - Run the built-in example project
#   lumina build          - Build the engine from source
#   lumina help           - Show this help message

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$ENGINE_DIR/build"
EXECUTABLE="$BUILD_DIR/bin/LuminaEngineExample"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_banner() {
    echo -e "${BLUE}"
    echo "  _                    _             "
    echo " | |   _   _ _ __ ___ (_)_ __   __ _ "
    echo " | |  | | | | '_ \` _ \| | '_ \ / _\` |"
    echo " | |__| |_| | | | | | | | | | | (_| |"
    echo " |_____\__,_|_| |_| |_|_|_| |_|\__,_|"
    echo -e "${NC}"
    echo "  Lumina Engine v1.0.0"
    echo ""
}

show_help() {
    print_banner
    echo "Usage: lumina <command> [options]"
    echo ""
    echo "Commands:"
    echo "  run [path]    Run a Lumina project. If path is provided, looks for"
    echo "                main.lua in that directory. Otherwise uses current dir."
    echo "  example       Run the built-in example/sandbox project"
    echo "  build         Build the engine from source"
    echo "  help          Show this help message"
    echo ""
    echo "Examples:"
    echo "  lumina run ./my_game"
    echo "  lumina example"
    echo "  lumina build"
}

build_engine() {
    echo -e "${YELLOW}Building Lumina Engine...${NC}"
    cd "$ENGINE_DIR"
    
    if [ ! -d "$BUILD_DIR" ]; then
        mkdir -p "$BUILD_DIR"
    fi
    
    cmake -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release
    cmake --build "$BUILD_DIR" --parallel
    
    echo -e "${GREEN}Build completed successfully!${NC}"
    echo "Executable: $EXECUTABLE"
}

run_project() {
    local project_path="${1:-.}"
    
    # Resolve to absolute path
    project_path="$(cd "$project_path" 2>/dev/null && pwd)" || {
        echo -e "${RED}Error: Directory '$1' not found${NC}"
        exit 1
    }
    
    # Check for main.lua
    if [ ! -f "$project_path/main.lua" ]; then
        echo -e "${RED}Error: No main.lua found in '$project_path'${NC}"
        echo "Lumina projects require a main.lua file in the project root."
        exit 1
    fi
    
    # Check if engine is built
    if [ ! -f "$EXECUTABLE" ]; then
        echo -e "${YELLOW}Engine not built. Building now...${NC}"
        build_engine
    fi
    
    echo -e "${GREEN}Running project: $project_path${NC}"
    cd "$project_path"
    "$EXECUTABLE" main.lua
}

run_example() {
    local example_path="$ENGINE_DIR/scripts"
    
    # Check if engine is built
    if [ ! -f "$EXECUTABLE" ]; then
        echo -e "${YELLOW}Engine not built. Building now...${NC}"
        build_engine
    fi
    
    # Check for example script
    if [ -f "$example_path/example.lua" ]; then
        echo -e "${GREEN}Running built-in example...${NC}"
        cd "$example_path"
        "$EXECUTABLE" example.lua
    else
        echo -e "${YELLOW}Running engine without script (demo mode)...${NC}"
        "$EXECUTABLE"
    fi
}

# Main command handling
case "${1:-help}" in
    run)
        run_project "$2"
        ;;
    example)
        run_example
        ;;
    build)
        build_engine
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'lumina help' for usage information."
        exit 1
        ;;
esac
